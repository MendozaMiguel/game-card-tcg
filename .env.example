# ==============================================================================
# L'Ordre des Arcanes Online — Template des variables d'environnement (.env)
#
# Initialisation locale :
#   Linux/macOS : cp .env.example .env
#   PowerShell  : Copy-Item .env.example .env
#   (Également effectué automatiquement par ./start-docker.ps1 et ./start-dev.ps1)
#
# IMPORTANT : ne jamais commiter `.env` ; remplacer tous les secrets en production.
# ==============================================================================

# --- Base de données PostgreSQL 17 (docker-compose.yml) ---
POSTGRES_DB=arcane_online
POSTGRES_USER=arcane
# [SECRET] À remplacer impérativement par un mot de passe robuste hors développement local
POSTGRES_PASSWORD=arcane_dev_password_change_me
POSTGRES_PORT=5432

# --- Sécurité Spring Boot / JWT HS512 & CORS ---
# [SECRET OBLIGATOIRE] Minimum 64 octets aléatoires (512 bits) pour la signature HS512 !
# Génération exemple : openssl rand -base64 64 | tr -d '\n'
ARCANE_JWT_SECRET=dev-only-64-byte-arcane-hs512-secret-key-please-override-in-prod!!
# Mettre à `true` derrière HTTPS en production (`false` uniquement en HTTP local)
ARCANE_COOKIE_SECURE=false
# Liste stricte des origines autorisées (CORS + handshake WebSocket STOMP)
# Pour tester sur mobile en LAN, ajouter par ex. : ,http://<VOTRE_IP_LAN>:4200
ARCANE_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# --- Reverse Proxy Nginx (arcane-web) ---
WEB_PORT=80

# --- Surcharges optionnelles Spring Boot (mode local hors Docker via ./start-dev.ps1) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/arcane_online
# SPRING_DATASOURCE_USERNAME=arcane
# SPRING_DATASOURCE_PASSWORD=arcane_dev_password_change_me
